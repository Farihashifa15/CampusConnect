# Database Configuration Template
# Set environment variables DB_USERNAME and DB_PASSWORD or configure below:
db.driver=com.mysql.cj.jdbc.Driver
db.url=jdbc:mysql://localhost:3306/campusconnect?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
db.username=root
db.password=YOUR_MYSQL_PASSWORD_HERE

# HikariCP Connection Pool Settings
db.pool.maximumPoolSize=10
db.pool.minimumIdle=2
db.pool.idleTimeout=30000
db.pool.connectionTimeout=10000

# Platform Policy Configurations
app.university.domain=@university.edu
app.credit.session.cost=10
app.credit.session.reward=10
app.credit.resource.reward=5
app.credit.answer.reward=15
app.upload.dir=uploads